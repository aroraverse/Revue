# Public base URL used to build QR/NFC links. No trailing slash.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key — server-only. Used by seed script and server routes
# that must bypass RLS (event logging, keepalive). NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Secret that Vercel Cron must send to hit /api/keepalive
CRON_SECRET=change-me
